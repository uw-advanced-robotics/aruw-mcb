<library>
  <repositories>
    <repository>
      <path>../taproot/repo.lb</path>
    </repository>
  </repositories>
  <options>
    <option name="taproot:rebuild_modm">True</option>
    <option name="taproot:project_name">aruw-mcb-project</option>
    <option name="taproot:dev_board">rm-dev-board-a</option>
    <option name="taproot:communication:serial:usart2.baud_rate">1000000</option>
    <option name="taproot:communication:serial:usart3.baud_rate">1000000</option>
    <option name="taproot:board:digital_in_pins">B,C,D,T</option>
    <option name="taproot:board:digital_out_pins">E,F,G,H,Y,Z,Laser</option>
    <option name="taproot:board:analog_in_pins">S,U,V</option>
    <option name="taproot:board:pwm_pins">W,X</option>
    <option name="taproot:modm-project.xml:modm_hal_options">
        modm:platform:uart:2:buffer.rx 512
        modm:platform:uart:2:buffer.tx 512
        modm:platform:uart:3:buffer.tx 2048
        modm:platform:uart:3:buffer.rx 2048
        modm:platform:uart:7:buffer.tx 512
        modm:platform:uart:7:buffer.rx 512
    </option>
    <option name="taproot:modm-project.xml:modm_hal_modules">modm:platform:random</option>
  </options>
  <modules>
    <module>taproot:algorithms:odometry</module>
    <module>taproot:architecture:profiler</module>
    <module>taproot:core</module>
    <module>taproot:communication:sensors:current:analog</module>
    <module>taproot:communication:sensors:buzzer</module>
    <module>taproot:communication:sensors:encoder:can_encoder</module>
    <module>taproot:communication:sensors:distance</module>
    <module>taproot:communication:sensors:distance:analog</module>
    <module>taproot:communication:sensors:limit-switch</module>
    <module>taproot:communication:gpio:leds</module>
    <module>taproot:communication:gpio:power_outs</module>
    <module>taproot:communication:gpio:digital</module>
    <module>taproot:communication:sensors:imu:display</module>
    <module>taproot:communication:sensors:imu:mpu6500</module>
    <module>taproot:display</module>
    <module>taproot:display:control</module>
    <module>taproot:display:motor</module>
    <module>taproot:display:ref_serial</module>
    <module>taproot:display:sh1106</module>
    <module>taproot:display:sh1107</module>
    <module>taproot:ext:littlefs</module>
    <module>taproot:ext:eigen</module>
    <module>taproot:errors</module>
    <module>taproot:motor:motorsim</module>
    <module>taproot:motor:pwm</module>
  </modules>
</library>
